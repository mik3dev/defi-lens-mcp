# Transport: stdio (default) or http
TRANSPORT=stdio

# JSON-RPC endpoint per chain. If unset, derived from ALCHEMY_API_KEY when present.
# At least one chain must end up enabled or startup fails.
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ARBITRUM=
RPC_URL_POLYGON=

# Alchemy key: indexer (token discovery, wallet transfers) and default RPC for all four chains
ALCHEMY_API_KEY=

# Simulation backend: rpc (default; eth_simulateV1, served by the Alchemy free tier on all four chains) or tenderly
SIMULATION_BACKEND=rpc

# Required when SIMULATION_BACKEND=tenderly
TENDERLY_ACCOUNT=
TENDERLY_PROJECT=
TENDERLY_ACCESS_KEY=

# Optional extra ABI source
ETHERSCAN_API_KEY=

# HTTP bind address (default 127.0.0.1:3000)
HOST=127.0.0.1
PORT=3000

# Comma-separated bearer tokens, each at least 32 characters; required when TRANSPORT=http
MCP_AUTH_TOKENS=

# Requests per minute per token (default 60)
RATE_LIMIT_RPM=60

# TTL in seconds for volatile data (default: per-chain block time)
CACHE_TTL_SECONDS=

# Blocks per eth_getLogs request (default 10: the Alchemy free-tier limit; raise it on a paid tier or another RPC)
LOGS_MAX_BLOCK_RANGE=10

# eth_getLogs requests per tool call (default 30; window scanned = range x requests, newest first)
LOGS_MAX_REQUESTS=30

# Log level: debug, info, warn, error (default info)
LOG_LEVEL=info
